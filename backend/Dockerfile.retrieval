FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    HF_HUB_DISABLE_TELEMETRY=1

WORKDIR /app

COPY requirements.txt requirements-retrieval.txt ./
# PyPI wheel тянет CUDA runtime даже для CPU-сервиса. Отдельный индекс PyTorch
# фиксирует воспроизводимый CPU-only слой до установки Sentence Transformers.
RUN pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cpu \
      torch==2.8.0+cpu \
    && pip install --no-cache-dir -r requirements-retrieval.txt

COPY . .

EXPOSE 8010
CMD ["uvicorn", "app.retrieval.runtime:app", "--host", "0.0.0.0", "--port", "8010"]
