# --- Справочные материалы, не часть репозитория ---
# virtex — прошлый проект, откуда взят UI-кит. Лежит рядом для чтения,
# у него свой .git. В историю Tentex не попадает.
virtex/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node ---
node_modules/
dist/
*.tsbuildinfo
.vite/

# --- Данные приложения ---
# База и файловое хранилище живут рядом с приложением и в git не едут
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# --- Секреты ---
.env
.env.local
*.key

# --- Тесты и артефакты ---
test-results/
playwright-report/
.coverage
htmlcov/

# --- Среда ---
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json

# --- Claude Code ---
.claude/settings.local.json
# skills — единственный источник в .agents/skills, .claude/skills это junction на него
.claude/skills/

# --- Local worktrees ---
.worktrees/

# --- Локальные инструменты и прогоны проверки ---
.codebase-memory/
output/
# Снимки визуальной проверки архитектурных страниц: пересоздаются прогоном,
# в истории не нужны — 12 МБ бинарников на каждую правку вёрстки.
docs/architecture/*.visual-check.*
