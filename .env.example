# Скопируй в .env и заполни. .env в git не едет.
# На этапе 0 ничего из этого не требуется — файл заведён заранее,
# чтобы ключи потом не расползлись по коду.

# Куда класть базу и файловое хранилище (по умолчанию ./data).
# TENTEX_DATA_DIR=./data

# Шлюз внешних моделей, OpenAI-совместимый (этап 7, §15 требований).
# TENTEX_LLM_BASE_URL=https://openrouter.ai/api/v1
# TENTEX_LLM_API_KEY=

# Распознавание речи, Groq Whisper (этап 10, §16 требований).
# TENTEX_GROQ_API_KEY=

# Telegram-бот (этап 10, §14 требований).
# TENTEX_TELEGRAM_BOT_TOKEN=
